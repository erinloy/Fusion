{
  "$schema": "NerdBank.GitVersioning/version.schema.json",
  "version": "14.3.19-ziltch.3",
  "assemblyVersion": {
    "precision": "revision"
  },
  "publicReleaseRefSpec": [
    "^refs/heads/master$",
    "^refs/heads/ziltch$"
  ],
  "cloudBuild": {
    "setVersionVariables": true,
    "setAllVariables": true,
    "buildNumber": {
      "enabled": true
    }
  },
  "nugetPackageVersion": {
    "semVer": 2
  }
}
